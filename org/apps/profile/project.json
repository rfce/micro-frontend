{
  "name": "profile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/profile/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project profile --web",
  "targets": {
    "build-prod": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm nx build profile",
          "pnpm nx preview profile"
        ],
        "parallel": false
      }
    }
  }
}