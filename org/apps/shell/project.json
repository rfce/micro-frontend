{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/shell/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project shell --web",
  "targets": {
    "build-prod": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm nx build shell",
          "pnpm nx preview shell"
        ],
        "parallel": false
      }
    },
    "serve-prod": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm nx build-prod products",
          "pnpm nx build-prod profile",
          "pnpm nx build-prod shell"
        ],
        "parallel": true
      }
    }
  }
}